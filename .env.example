# Map Provider: "auto" | "osm" | "amap" | "google" | "demo"
MAP_PROVIDER=auto
AMAP_API_KEY=
GOOGLE_MAPS_API_KEY=

# LLM Provider: "auto" | "free_public" | "kimi_web" | "deepseek_web" | "qwen_web" | "doubao_web" | "official"
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional Web-Edition Free Ports (Chat2API / free-llm-hub / Kimi Connect-RPC JWT)
FREE_WEB_GATEWAY_URL=
KIMI_WEB_URL=http://127.0.0.1:8010/v1
KIMI_WEB_TOKEN=
DEEPSEEK_WEB_URL=http://127.0.0.1:8011/v1
DEEPSEEK_WEB_TOKEN=
QWEN_WEB_URL=http://127.0.0.1:8012/v1
QWEN_WEB_TOKEN=
DOUBAO_WEB_URL=http://127.0.0.1:8014/v1
DOUBAO_WEB_TOKEN=

# 0.0.0.0 lets phones on the same Wi-Fi open the app
HOST=0.0.0.0
PORT=8780
